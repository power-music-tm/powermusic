# Copy to backend/.env — never commit real values.

# ── Database (backend only) ──────────────────────────────────────────────────
# Use the Supabase TRANSACTION pooler — host ends in .pooler.supabase.com and
# the port is 6543 (NOT 5432). The 5432 "session" pooler caps concurrent clients
# at ~15 and will hang/500 under serverless + normal use ("max clients reached
# in session mode"). 6543 multiplexes and scales. URL-encode the password
# (e.g. @ -> %40). Get it from Supabase → Connect → Transaction pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Optional: fail a stuck DB connect fast instead of hanging the request.
# DB_CONNECT_TIMEOUT=10

# ── API authentication (required in production) ───────────────────────────────
# Recommended: asymmetric JWT signing keys (JWKS) — set your project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Optional: pin the active signing key id from Supabase → Settings → API → JWT Keys
# SUPABASE_JWT_KEY_ID=aa2671fe-6a4f-4650-b5d9-47b06006075f
# Legacy HS256 fallback (older projects only; not needed with JWKS)
# SUPABASE_JWT_SECRET=
# Local dev only: set to 1 to skip JWT checks when auth env vars are unset
# DISABLE_API_AUTH=1
# Local dev only: set to 1 to skip rate limits when DISABLE_API_AUTH=1
# DISABLE_RATE_LIMIT=1

# ── Supabase admin bootstrap (manual one-time — NOT on Vercel deploy) ─────────
# Run: python backend/seed_admin.py  OR  node scripts/seed-admin.mjs
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose to frontend
# Required on the Vercel *backend* service for instant admin dashboard nudges
# (New Requests + Email responses via Supabase Realtime broadcast).
# ADMIN_EMAIL=andrea@powermusic.com
# ADMIN_PASSWORD=              # required in production; store in password manager
# ADMIN_FULL_NAME=Andrea
# ADMIN_FORCE_PASSWORD_RESET=1 # optional one-off password reset (Python seed only)

# ── Secret encryption (recommended in production) ────────────────────────────
# Encrypts Gmail OAuth refresh tokens at rest (Fernet). Without it, tokens are
# stored as plain text (a warning is logged). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe — losing it means every inbox must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Pilot 2 — AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Fallback model tried when the primary is rate-limited (429). MUST differ from
# the primary — Gemini quotas are per-model. Default: gemini-2.5-flash.
# PILOT2_BACKUP_MODEL=gemini-2.5-flash

# ── Pilot 2 — Gmail OAuth ────────────────────────────────────────────────────
# PILOT2_GMAIL_MODE: "mock" = no Google calls (dev default), "live" = real Gmail
PILOT2_GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long-lived connections require the OAuth consent screen Publishing status
# "In production" (not "Testing"). Testing mode refresh tokens expire after
# 7 days and return invalid_grant — users must reconnect. Publish at:
#   Google Cloud Console → APIs & Services → OAuth consent screen → Publish app
# Gmail scopes may also need Google verification for broad external use.
# In production this MUST be the deployed callback and be registered in Google
# Cloud → Credentials → Authorized redirect URIs, or OAuth hangs on localhost.
#   e.g. https://your-app.vercel.app/api/pilot2/inboxes/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/pilot2/inboxes/oauth/callback
# Where the OAuth success page's buttons/logo link back to (prod frontend URL).
# PILOT2_FRONTEND_URL=https://your-app.vercel.app

# ── Pilot 2 — Gmail push (Pub/Sub) so new mail syncs in ~1s ───────────────────
# projects/<gcp-project>/topics/<topic>; grant the topic publish rights to
# gmail-api-push@system.gserviceaccount.com. Pub/Sub push subscription URL:
#   https://your-app.vercel.app/api/pilot2/gmail/push?token=<PILOT2_GMAIL_PUSH_TOKEN>
# PILOT2_GMAIL_PUBSUB_TOPIC=
# PILOT2_GMAIL_PUSH_TOKEN=          # shared secret in the push URL (?token=)

# ── Supabase Realtime (instant dashboard updates, no reload) ──────────────────
# Backend broadcasts a "workspace-changed" nudge when new mail syncs. Needs the
# SERVICE ROLE key (server-only). Without it the dashboard only updates on its
# 30s poll. Frontend also needs VITE_SUPABASE_URL/ANON_KEY to subscribe.
# Also used for partner logo object storage (bucket: partner-logos).
# SUPABASE_SERVICE_ROLE_KEY=

# Required in production for cron workers:
# /api/pilot2/poll, /api/pilot2/learning/distill
# (/api/jobs/process-manager-submissions is optional — batch submits run inline)
#
# Vercel Hobby allows daily crons only (see vercel.json). For Gmail poll more
# than once/day, use an external scheduler (e.g. cron-job.org) hitting
# GET /api/pilot2/poll?secret=<CRON_SECRET> every 5–15 minutes.
#
# On Vercel, set CRON_SECRET to a random 16+ char string — Vercel sends it as
# Authorization: Bearer <CRON_SECRET> on every cron invocation. Set the same
# value as PILOT2_CRON_SECRET (or either env var alone is accepted).
PILOT2_CRON_SECRET=
# CRON_SECRET=

# Optional tuning
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=12
# DB_POOL_TIMEOUT=30
# PILOT2_POLL_INTERVAL_MINUTES=1
# PILOT2_DISTILL_HOUR_UTC=2
# PILOT2_SCHEDULER_ENABLED=true
# PILOT2_MAX_RULES_PER_INTENT=10
